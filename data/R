# ------------------------------------------------------------------
# 01_import_omi.R
# Importa le quotazioni OMI di Milano (un file per semestre e tipo)
# e produce un unico dataset pulito in data/clean/.
#
# Fonte dei dati: Agenzia Entrate - OMI
#
# Uso: apri il progetto in RStudio (cartella principale del repository),
# metti i file scaricati in data/raw/ e lancia lo script.
# I file devono chiamarsi omi_*.csv (es. omi_2016_1_prezzi.csv).
# Il tipo di file (prezzi o zone) e il semestre vengono letti dal
# contenuto, non dal nome: anche se i nomi sono scambiati funziona.
# ------------------------------------------------------------------

library(readr)
library(dplyr)
library(stringr)
library(purrr)

cartella_raw <- "data/raw"
file_output  <- "data/clean/omi_milano_affitti.csv"

# Converte numeri col formato italiano ("29,2" -> 29.2)
num <- function(x) parse_number(x, locale = locale(decimal_mark = ","))

# Legge un file OMI e ne riconosce tipo e semestre
leggi_omi <- function(percorso) {
  # riga 1 = titolo (contiene il semestre), riga 2 = intestazione
  titolo <- read_lines(percorso, n_max = 1,
                       locale = locale(encoding = "latin1"))
  m <- str_match(titolo, "Semestre\\s+(\\d{4})/(\\d)")
  if (anyNA(m)) stop("Semestre non riconosciuto in: ", percorso)

  dati <- read_delim(
    percorso, delim = ";", skip = 1,
    col_types = cols(.default = col_character()),
    locale = locale(encoding = "latin1"),
    show_col_types = FALSE
  ) %>%
    # l'intestazione finisce con ";" e crea una colonna vuota: la tolgo
    select(!matches("^(\\.\\.\\.|X)[0-9]+$"))

  tipo <- if ("Loc_min" %in% names(dati)) {
    "prezzi"
  } else if ("Zona_Descr" %in% names(dati)) {
    "zone"
  } else {
    stop("Tipo di file non riconosciuto: ", percorso)
  }

  dati <- dati %>%
    mutate(anno     = as.integer(m[1, 2]),
           semestre = as.integer(m[1, 3]),
           periodo  = paste0(anno, "-S", semestre))

  list(tipo = tipo, dati = dati)
}

# 1. Lettura di tutti i file -----------------------------------------
file_omi <- list.files(cartella_raw, pattern = "^omi_.*\\.csv$",
                       full.names = TRUE)
if (length(file_omi) == 0) stop("Nessun file omi_*.csv in ", cartella_raw)

letti <- map(file_omi, leggi_omi)

prezzi_raw <- letti %>% keep(~ .x$tipo == "prezzi") %>%
  map("dati") %>% bind_rows()
zone_raw   <- letti %>% keep(~ .x$tipo == "zone") %>%
  map("dati") %>% bind_rows()

# 2. Pulizia dei prezzi ----------------------------------------------
prezzi <- prezzi_raw %>%
  filter(Comune_descrizione == "MILANO") %>%
  mutate(
    across(c(Compr_min, Compr_max, Loc_min, Loc_max), num),
    # nei dati OMI un affitto pari a 0 significa "dato mancante"
    across(c(Loc_min, Loc_max), ~ na_if(.x, 0)),
    loc_medio = (Loc_min + Loc_max) / 2   # euro/mq al mese, punto medio
  ) %>%
  select(periodo, anno, semestre, LinkZona, Zona, Fascia,
         Cod_Tip, Descr_Tipologia, Stato, Stato_prev,
         Compr_min, Compr_max, Loc_min, Loc_max, loc_medio, Sup_NL_loc)

# 3. Nomi delle zone -------------------------------------------------
# La descrizione di una zona puo' cambiare nel tempo: tengo la piu' recente
zone <- zone_raw %>%
  filter(Comune_descrizione == "MILANO") %>%
  mutate(Zona_Descr = str_remove_all(Zona_Descr, "^'|'$")) %>%
  arrange(desc(anno), desc(semestre)) %>%
  distinct(LinkZona, .keep_all = TRUE) %>%
  select(LinkZona, Zona_Descr, Microzona)

omi <- prezzi %>%
  left_join(zone, by = "LinkZona") %>%
  arrange(periodo, Zona, Descr_Tipologia, Stato)

# 4. Controlli veloci ------------------------------------------------
cat("Semestri importati:", paste(sort(unique(omi$periodo)), collapse = ", "), "\n")
cat("Righe:", nrow(omi), "| Zone:", n_distinct(omi$LinkZona), "\n")
cat("Superficie (Sup_NL_loc; L = lorda, N = netta):\n")
print(table(omi$Sup_NL_loc, omi$periodo))
cat("Affitti mancanti (Loc_min):", sum(is.na(omi$Loc_min)), "\n")
if (anyNA(omi$Zona_Descr)) {
  warning("Alcune zone non hanno descrizione: manca un file 'zone' di quel semestre?")
}

# 5. Salvataggio -----------------------------------------------------
dir.create(dirname(file_output), showWarnings = FALSE, recursive = TRUE)
write_csv(omi, file_output)
cat("Dataset salvato in", file_output, "\n")

